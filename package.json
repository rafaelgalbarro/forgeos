    "architecture:check:6050": "node scripts/architecture-check-6050.js",
    "architecture:check:6060": "node scripts/architecture-check-6060.js",
    "architecture:check:6070": "node scripts/architecture-check-6070.js",
    "typecheck": "tsc --noEmit",
    "typecheck:delivery-6050": "tsc --noEmit -p tsconfig.delivery-6050.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:6020": "vitest run src/core/application/__tests__/application-layer.test.ts",
    "test:6060": "node scripts/experience-6060-smoke.js",
    "test:migration-6070": "vitest run tests/migration/migration-6070.test.ts",
    "test:events": "npx --yes tsx src/core/events/__tests__/program-6040.test.ts",
    "test:delivery-6050": "npx --yes tsx src/core/delivery/__tests__/delivery-model-6050.test.ts",
    "migrate:delivery-6050": "npx --yes tsx scripts/migrate-delivery-model-6050.ts",
    "migrate:v2:missions": "npx --yes tsx scripts/migrate-v2-missions.ts",
    "migrate:v2:decisions": "npx --yes tsx scripts/migrate-v2-decisions.ts",
    "migrate:v2:outputs": "npx --yes tsx scripts/migrate-v2-outputs.ts",
    "rollback:v2": "npx --yes tsx scripts/rollback-v2.ts",
    "verify:6070": "node scripts/verify-program-6070.js",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "test:orchestration": "npx --yes tsx src/core/orchestration/orchestration-kernel.test.ts",
    "validate:orchestration": "npx --yes tsx scripts/validate-orchestration-kernel.ts",
    "measure:routes": "npx --yes tsx scripts/performance/measure-routes.ts",
