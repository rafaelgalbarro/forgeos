    "clean": "node scripts/clean.js",
    "kill:ports": "node scripts/kill-ports.js",
    "doctor": "node scripts/doctor.js",
    "check": "node scripts/doctor.js && next build",
    "check:v2-boundaries": "node scripts/check-v2-boundaries.js",
    "validate:v2-integration": "node scripts/run-sequential-v2-validation.js",
    "wait:ready": "node scripts/wait-for-forgeos-ready.js",
