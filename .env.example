# ForgeOS — Variables de entorno

# Proveedor IA visible en UI (stub | openai | anthropic)
NEXT_PUBLIC_AI_PROVIDER=stub

# ── AI Gateway (Release multi-provider) ──────────────────────────
AI_DEFAULT_PROVIDER=anthropic
AI_FALLBACK_PROVIDER=openai
AI_ENABLE_MOCK_FALLBACK=true

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-1.5-pro

# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Groq (gratis en console.groq.com — scanner masivo Fase 2)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Yahoo Finance (sin key, gratis — fallback cuando Polygon no responde)
USE_YAHOO_FINANCE=true

# Polygon.io — fuente primaria de mercado (quotes, barras diarias, FX conversion)
# Obtener key en https://polygon.io/
POLYGON_API_KEY=
USE_POLYGON=true

# Phase L — Cartera Largo Plazo (/investment/portfolio) — value screen + dividends + soft rebalance
# ANALYSIS_ONLY — no orders. Uses Yahoo quoteSummary / chart events.
LONG_TERM_PORTFOLIO_ENABLED=true

# Multi-IA Market Scanner — universo institucional (S&P + Russell + NASDAQ + NYSE + Europa)
SCAN_UNIVERSE=ALL
MIN_PRICE=0.1
MIN_VOLUME=100000
MAX_SPREAD_PCT=1
MAX_TICKERS_PHASE2=50
MAX_TICKERS_PHASE3=10
# MARKET_SCANNER_ENABLED=false

# Institutional scanner (Fase A) — opcional Unusual Whales tier gratuito
# UNUSUAL_WHALES_API_KEY=

# Local / Open Source (OpenAI-compatible endpoint)
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=local

# ── AI Runtime RC3 — Extended Providers ───────────────────────────
AI_MONTHLY_BUDGET_USD=100

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL=gpt-4o

# AWS Bedrock (stub)
AWS_BEDROCK_REGION=
AWS_BEDROCK_MODEL=anthropic.claude-3-sonnet
AWS_ACCESS_KEY_ID=

# Vertex AI
VERTEX_AI_API_KEY=
VERTEX_AI_BASE_URL=
VERTEX_AI_MODEL=gemini-1.5-pro

# Cohere
COHERE_API_KEY=
COHERE_MODEL=command-r-plus

# xAI
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-beta

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# LM Studio (local)
LMSTUDIO_BASE_URL=http://localhost:1234
LMSTUDIO_MODEL=local-model

# Llama (via Groq or custom endpoint)
LLAMA_API_KEY=
LLAMA_BASE_URL=
LLAMA_MODEL=llama-3.3-70b

# MCP — Model Context Protocol (pending)
# MCP_ENDPOINT=
# MCP_MODEL=mcp-pending

# ── Real Connections RC5 — External Tools (server-side only) ─────
GITHUB_TOKEN=
SUPABASE_ACCESS_TOKEN=
VERCEL_TOKEN=
CLOUDFLARE_API_TOKEN=
# Set to "true" to allow production execution (requires governance approval + user confirm)
# FORGEOS_CONNECTIONS_PRODUCTION=false

# ── Real Execution RC5.1 — Approval Layer (server-side only) ────
ENABLE_REAL_EXECUTION=false
REAL_EXECUTION_ALLOWED_PROVIDERS=github,vercel,supabase,cloudflare
REAL_EXECUTION_REQUIRE_APPROVAL=true
REAL_EXECUTION_DEFAULT_ENVIRONMENT=preview
REAL_EXECUTION_ALLOW_DESTRUCTIVE=false

# Per-provider real execution (RC5.3) — all false by default
ENABLE_REAL_GITHUB_EXECUTION=false
ENABLE_REAL_VERCEL_EXECUTION=false
ENABLE_REAL_SUPABASE_EXECUTION=false
ENABLE_REAL_CLOUDFLARE_EXECUTION=false

# ── Real AI Execution Platform RC6 (server-side only) ─────────────
ENABLE_REAL_AI=false
ENABLE_STREAMING=true
ENABLE_MULTI_PROVIDER_ROUTING=true
ENABLE_COST_OPTIMIZER=true

# ── Program 3000 Sprint 4 — Design Partner AI Gate ───────────────
# Real AI activates only when ENABLE_REAL_AI=true AND (design partner OR keys below)
ENABLE_DESIGN_PARTNER_AI=false
DESIGN_PARTNER_MODE=false
NEXT_PUBLIC_DESIGN_PARTNER_MODE=false

# ── Program 5000 — Design Partner Program ───────────────────────
ENABLE_DESIGN_PARTNER_ANALYTICS=true
NEXT_PUBLIC_ENABLE_DESIGN_PARTNER_ANALYTICS=true
# Optional analytics POST endpoint (reuses BETA_ANALYTICS_ENDPOINT if unset)
# DESIGN_PARTNER_ANALYTICS_ENDPOINT=

# RC6 provider keys (aliases supported)
GEMINI_API_KEY=
AZURE_OPENAI_KEY=
LM_STUDIO_BASE_URL=http://localhost:1234

# ── Real Build Flow RC5.2 — Venture → Preview (server-side only) ──
ENABLE_REAL_BUILD_FLOW=false
REAL_BUILD_REQUIRE_APPROVAL=true
REAL_BUILD_DEFAULT_ENVIRONMENT=preview

# ── Program 3000 Sprint 5 — Build Pipeline (server-side only) ─────
# Unified dashboard at /deployments — preview only, approval required
# ENABLE_REAL_BUILD_FLOW=false (reuses RC5.2 flags above)
# All real execution behind ENABLE_REAL_EXECUTION + per-provider flags

# ── Program 3000 Sprint 6 — Private Beta Platform ───────────────
BETA_MODE=true
NEXT_PUBLIC_BETA_MODE=true
ENABLE_BETA_ANALYTICS=true
NEXT_PUBLIC_ENABLE_BETA_ANALYTICS=true
ENABLE_CRASH_REPORTS=true
NEXT_PUBLIC_ENABLE_CRASH_REPORTS=true
# Optional analytics POST endpoint (stub — no external SDK required)
# BETA_ANALYTICS_ENDPOINT=

# ── Program 3000 — Identity Platform (Sprint 1) ─────────────────
NEXT_PUBLIC_AUTH_ENABLED=true
# local | supabase | authjs
NEXT_PUBLIC_AUTH_PROVIDER=local

# Private Founder platform (single user) — registration disabled
FOUNDER_USERNAME=rafa2200
NEXT_PUBLIC_FOUNDER_USERNAME=rafa2200

# Supabase Auth (when NEXT_PUBLIC_AUTH_PROVIDER=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Auth.js / NextAuth (when NEXT_PUBLIC_AUTH_PROVIDER=authjs)
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Program 3000 Sprint 3 — Venture Persistence ───────────────────
# local | supabase | postgres
PERSISTENCE_PROVIDER=local
NEXT_PUBLIC_PERSISTENCE_PROVIDER=local

# Supabase persistence (when PERSISTENCE_PROVIDER=supabase)
# Reuses NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY above
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Postgres persistence (when PERSISTENCE_PROVIDER=postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/forgeos

# ── Program 6000 — Commercial Readiness ───────────────────────────
COMMERCIAL_MODE=true
NEXT_PUBLIC_COMMERCIAL_MODE=true
ENABLE_STRIPE_BILLING=false
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# ENABLE_COMMERCIAL_EMAILS=false

# ── Program 9000 — Intelligence Network ───────────────────────────
ENABLE_INTELLIGENCE_NETWORK=false
NETWORK_CONSENT_REQUIRED=true
ENABLE_ANONYMIZED_BENCHMARKS=true

# ── Program 8000 — Customer Success Platform ────────────────────
ENABLE_CUSTOMER_SUCCESS_ANALYTICS=true
NEXT_PUBLIC_CS_PLATFORM=true
# Optional analytics POST endpoint (reuses DESIGN_PARTNER_ANALYTICS_ENDPOINT)
# CUSTOMER_SUCCESS_ANALYTICS_ENDPOINT=

# ── Program 7000 — ForgeOS 1.0 Launch ────────────────────────────
FORGEOS_LAUNCH_MODE=true
NEXT_PUBLIC_LAUNCH_MODE=true

# ── Program 6500 — Production Readiness ───────────────────────────
ENABLE_PRODUCTION_MONITORING=true
NEXT_PUBLIC_ENABLE_PRODUCTION_MONITORING=true
ENABLE_KILL_SWITCH=false
PRODUCTION_HEALTH_ENDPOINT=
PRODUCTION_DRY_RUN=true
ENABLE_STRUCTURED_LOGGING=false
ENABLE_PRODUCTION_TRACING=false
ENABLE_PRODUCTION_METRICS=false
NEXT_PUBLIC_ENABLE_PRODUCTION_METRICS=false
PRODUCTION_RATE_LIMIT_PER_MINUTE=120
# KILL_SWITCH_REASON=
# KILL_SWITCH_ACTIVATED_AT=

# ── Program 4300 — Cloud Foundation (preparation only) ────────────
CLOUD_DRY_RUN=true
CLOUD_PREVIEW_ONLY=true
CLOUD_PRODUCTION_BLOCKED=true
CLOUD_ACTIVE_ENVIRONMENT=preview
CLOUD_PROVIDERS=github,vercel,cloudflare,supabase

# ── Investment OS Safety Mode (mandatory default) ──────────────────
# paper | ANALYSIS_ONLY | AUTONOMOUS_LIVE (mode may exist but stays LOCKED) | live
TRADING_MODE=ANALYSIS_ONLY
BROKER_ENGINE=paper
# Keep false unless explicit supervised activation after certification.
LIVE_TRADING_ENABLED=false
# Optional paper persistence path (defaults to .forgeos/registry/paper-trading-state.json)
# PAPER_TRADING_STORE_PATH=
# PAPER_STARTING_EQUITY=100000
# PAPER_RISK_FREE_RATE=0
# PAPER_CERTIFICATION_WINDOW_DAYS=30
# PAPER_CERTIFICATION_MIN_TRADES=100
# Shadow mode is separate hypothetical evaluation; keep false for paper certification path.
# SHADOW_MODE=false
# IBKR read-only analysis (server-only — never NEXT_PUBLIC_*)
# IBKR_SERVICE_URL=http://127.0.0.1:8002
# IBKR_INTERNAL_API_KEY=
IBKR_READ_ONLY=true

# Phase F — Smart execution (planning + pre-trade gates; does NOT unlock unsupervised live)
# SMART_EXECUTION_ENABLED builds BRACKET/OCO/TRAILING/VWAP/ICEBERG intents; IBKR submit stays LMT.
SMART_EXECUTION_ENABLED=true
# PRETRADE_CHECKLIST_ENABLED gates PENDING_APPROVAL / approveAndExecute (HOLD + Telegram on fail).
PRETRADE_CHECKLIST_ENABLED=true
# When true, missing Yahoo earnings calendar fails closed. Default soft NO_DATA pass.
# PRETRADE_FAIL_ON_MISSING_EARNINGS=false

# Phase G — Portfolio Optimizer (Kelly + correlation + defensive caps; ANALYSIS_ONLY / paper-safe)
# Applies size caps + allow/deny for NEW trades. Reduce/close actions are Telegram recommendations only.
PORTFOLIO_OPTIMIZER_ENABLED=true
# Cap on Kelly fraction of NAV per new trade (default 0.25 = 25%)
KELLY_FRACTION_CAP=0.25
# VIX above this → defensive universe only (GLD, TLT, VXX) for new buys
DEFENSIVE_VIX_THRESHOLD=30

# Phase H — Own ML signal trainer (pure-TS logistic regression; ANALYSIS_ONLY)
# Stores signals+outcomes under .forgeos/ml/signals.jsonl; soft scanner weights in scanner-weights.json
# Never auto-places orders. Needs ≥ ML_MIN_SAMPLES labeled TP/SL outcomes before TRAINED.
ML_SIGNAL_TRAINER_ENABLED=true
ML_MIN_SAMPLES=50

# Morning Briefing (PDF + optional email) — ANALYSIS_ONLY, no orders
# Cron: npm run investment:morning-briefing  (recommended 08:00 Europe/Madrid Mon–Fri)
INVESTMENT_BRIEFING_EMAIL_TO=rafaelgalbarro@gmail.com
INVESTMENT_BRIEFING_EMAIL_ENABLED=false
# INVESTMENT_BRIEFING_EMAIL_FROM=forgeos-briefing@example.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# SMTP_FROM=

# Daily investment PDF report (EOD) — ANALYSIS_ONLY, append-only
# Cron: npm run report:investment-daily  (e.g. 17:00 weekdays)
# Artifacts: .forgeos/reports/investment/daily/*.pdf (+ .html)
INVESTMENT_REPORT_EMAIL_ENABLED=false
# INVESTMENT_REPORT_EMAIL_TO=

# Market Intelligence (optional — empty registry → screener NO_DATA, never invents quotes)
# FORGEOS_MARKET_PROVIDERS=polygon,finnhub,alpha-vantage
# POLYGON_API_KEY=
# FINNHUB_API_KEY=
# ALPHA_VANTAGE_API_KEY=
# FMP_API_KEY=
# TWELVE_DATA_API_KEY=
# NEWSAPI_KEY=
# ForgeOS Investment — NewsAPI.org (free tier) for ticker news aggregation
NEWS_API_KEY=
# Telegram Bot — obtener de @BotFather en Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloudflare Tunnel — para acceso remoto permanente
CLOUDFLARE_TUNNEL_TOKEN=
# FORGEOS_PUBLIC_URL=https://investment.tudominio.com

# ── Phase M — Public API / integrations (ANALYSIS_ONLY; never auto-places live orders) ──
# Public API: GET /api/public/v1/health (open), /opportunities + /status (API key gated)
# Header: Authorization: Bearer <key>  or  X-ForgeOS-API-Key: <key>
# FORGEOS_PUBLIC_API_KEY=
# Outbound JSON to Google Sheets Apps Script / Zapier / Make (daily report + cycle_complete)
# FORGEOS_SHEETS_WEBHOOK_URL=
# FORGEOS_EXPORT_WEBHOOK_URL=
# TradingView alert webhook: POST /api/webhooks/tradingview  (queues watchlist/cycle only)
# TRADINGVIEW_WEBHOOK_SECRET=
# Multi-account IBKR. Primary (orders + trading cash) first.
IBKR_ACCOUNT_ID=U15513057
IBKR_ACCOUNT_IDS=U15513057,U24225949

# Notificaciones push Telegram
NOTIFY_ON_SIGNAL=true
NOTIFY_ON_EXECUTION=true
NOTIFY_ON_HALT=true
NOTIFY_ON_ALERT=true
NOTIFY_ON_REPORT=true

# Alerts & Watchlist sidecar (evalúa alertas cada 2–10 min vía /api/investment/alerts)
# ALERTS_POLL_ENABLED=false

# Telegram reports sidecar (Europe/Madrid; POST /api/investment/reports?type=auto)
# Morning market 08:30 + evening ops 22:00 + weekly Sunday 20:00 — each with PDF via sendDocument
# REPORTS_POLL_ENABLED=false
# REPORT_MORNING_HOUR=8
# REPORT_MORNING_MINUTE=30
# REPORT_DAILY_HOUR=22
# REPORT_WEEKLY_HOUR=20
# REPORTS_POLL_MS=120000

# Sentiment aggregator — StockTwits, Reddit, CNN Fear & Greed, VIX (all free)
SENTIMENT_AGGREGATOR_ENABLED=true
# Inter-market / macro context — TLT, DXY/UUP, GLD, USO, VIX, sector ETFs, FRED T10Y2Y
MACRO_CONTEXT_ENABLED=true
# FRED_API_KEY=
# Zero-key providers are enabled explicitly here; no credentials are required.
ECB_ENABLED=true
WORLDBANK_ENABLED=true
WORLDBANK_COUNTRY=USA
# YAHOO_FINANCE_ENABLED=false
# Advanced backtesting (/investment/backtesting?mode=advanced) uses Yahoo chart bars via
# USE_YAHOO_FINANCE (default true). Set false to force DEMO synthetic OHLCV.
# Horizons: intraday=5m/60d (Yahoo cap), swing=1d/2y, daily5y=1d/5y. ANALYSIS_ONLY — no orders.
# Comma-separated public RSS/Atom feeds. Replace or extend for your operating universe.
RSS_FEED_URLS=https://www.federalreserve.gov/feeds/press_all.xml
# Optional external benchmark(s) for performance beta/alpha/corr/TE/IR (requires a market provider key)
# FORGEOS_BENCHMARK_SYMBOL=SPY
# FORGEOS_BENCHMARK_SYMBOLS=QQQ,IWM

