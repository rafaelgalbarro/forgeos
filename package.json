    "measure:memory": "npx --yes tsx scripts/performance/measure-memory.ts",
    "measure:container": "npx --yes tsx scripts/performance/measure-v2-container.ts",
    "measure:performance": "npx --yes tsx scripts/performance/performance-report.ts",
    "check:performance-budgets": "npx --yes tsx scripts/check-performance-budgets.ts",
    "test:6100": "vitest run src/core/performance/__tests__/program-6100.test.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "next": "15.5.19",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lightweight-charts": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.19",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.18.0"
  }
