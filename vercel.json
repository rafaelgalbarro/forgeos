{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "regions": ["cdg1"],
  "git": {
    "deploymentEnabled": {
      "main": false,
      "develop": false,
      "release/*": true,
      "feature/*": true
    }
  },
  "env": {
    "CLOUD_DRY_RUN": "true",
    "CLOUD_PREVIEW_ONLY": "true",
    "CLOUD_PRODUCTION_BLOCKED": "true",
    "CLOUD_ACTIVE_ENVIRONMENT": "preview"
  },
  "build": {
    "env": {
      "CLOUD_DRY_RUN": "true"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-ForgeOS-Cloud", "value": "4300-preparation" }
      ]
    }
  ]
}
