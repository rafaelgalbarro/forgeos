{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/core/*": [
        "./src/core/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-6040/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-6010/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "scripts",
    "**/*.test.ts",
    "vitest.config.ts"
  ]
}
