    "report:investment-daily": "npx --yes tsx scripts/generate-daily-investment-report.ts",
    "architecture:check": "node scripts/architecture-check-6000.js && node scripts/architecture-check-6020.js && node scripts/architecture-check-6040.js && node scripts/architecture-check-6050.js && node scripts/architecture-check-6060.js && node scripts/architecture-check-6070.js",
    "architecture:check:6000": "node scripts/architecture-check-6000.js",
    "architecture:check:6020": "node scripts/architecture-check-6020.js",
