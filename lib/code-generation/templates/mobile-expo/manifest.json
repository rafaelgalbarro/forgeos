{
  "id": "mobile-expo",
  "name": "Mobile — Expo Router",
  "version": "1.0.0",
  "projectType": "mobile",
  "stack": {
    "framework": "expo",
    "language": "typescript",
    "mobile": "react-native",
    "auth": "expo-secure-store"
  },
  "structure": [
    "app/_layout.tsx",
    "app/(tabs)/",
    "app/(auth)/",
    "components/",
    "lib/api/",
    "lib/auth/",
    "assets/",
    "__tests__/"
  ],
  "dependencies": {
    "expo": "~52.0.0",
    "expo-router": "~4.0.0",
    "react": "18.3.1",
    "react-native": "0.76.x",
    "expo-secure-store": "~14.0.0",
    "@react-navigation/native": "^7.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "jest": "^29.7.0",
    "@types/react": "~18.3.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest"
  },
  "envVars": [
    { "key": "EXPO_PUBLIC_API_URL", "description": "Backend API base URL", "example": "http://localhost:4000", "required": true }
  ],
  "conventions": {
    "appDir": "app",
    "componentsDir": "components",
    "libDir": "lib",
    "testsDir": "__tests__",
    "naming": "Expo Router file-based routing"
  },
  "generator": "mobile-generator"
}
