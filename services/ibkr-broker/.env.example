APP_ENV=development
INTERNAL_API_KEY=replace-with-a-long-random-secret
APPROVAL_SECRET=replace-with-a-different-long-random-secret

IBKR_HOST=127.0.0.1
# IMPORTANTE: Puerto TWS paper trading = 7497, NO cambiar a 4001
IBKR_PORT=7497
IBKR_CLIENT_ID=41
# Optional: official TWS API pythonclient path (preferred over site-packages ibapi)
# Example: C:\\TWS API\\source\\pythonclient
IBKR_TWS_API_PYTHONPATH=
IBKR_ACCOUNT_ID=U15513057
IBKR_ACCOUNT_IDS=U15513057,U24225949
IBKR_CONNECT_TIMEOUT_SECONDS=12
IBKR_READ_ONLY=true

LIVE_TRADING_ENABLED=false
PROPOSAL_TTL_SECONDS=600
MAX_ORDER_NOTIONAL=100
MAX_ORDER_QUANTITY=2
ALLOWED_SYMBOLS=SPY,QQQ,IWM,TLT,ARKK,AAPL,MSFT,NVDA,TSLA,AMZN,GOOGL,META,EZU,VGK,ASML,SAP,SHOP,SHEL,BP,EWJ,FXI,EWY,BABA,NIO,TSM,MELI,GRAB,DLO,IBN,IBIT,FETH
ALLOWED_CURRENCIES=EUR,USD,GBP,JPY,HKD,CHF,DKK,AUD,CAD
ALLOWED_EXCHANGES=SMART,LSE,XETRA,AEB,TSE,HKEX,ASX,EURONEXT,CPH,IDEALPRO
ALLOW_OUTSIDE_RTH=false
DATABASE_PATH=./forgeos_ibkr.sqlite3

# FOREX (IDEALPRO CASH) — endpoints /api/forex/* (block 2+)
FOREX_ENABLED=false
FOREX_MAX_SPREAD_PIPS=3
FOREX_MAX_POSITIONS=3
FOREX_RISK_PCT=2
FOREX_STOP_PIPS=20
FOREX_TP_PIPS=40
FOREX_MIN_CONFIDENCE=0.75
FOREX_MIN_UNITS=25000
FOREX_ALLOWED_PAIRS=EURUSD,GBPUSD,USDJPY,USDCHF,AUDUSD,USDCAD,EURGBP,EURJPY,GBPJPY
