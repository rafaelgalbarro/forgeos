{
  "id": "website-nextjs",
  "name": "Website — Next.js",
  "version": "1.0.0",
  "projectType": "website",
  "stack": {
    "framework": "nextjs",
    "language": "typescript",
    "styling": "tailwindcss"
  },
  "structure": [
    "app/layout.tsx",
    "app/page.tsx",
    "app/globals.css",
    "components/ui/",
    "components/sections/",
    "lib/brand.ts",
    "public/",
    "tests/"
  ],
  "dependencies": {
    "next": "15.x",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tailwindcss": "^3.4.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "vitest": "^2.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run"
  },
  "envVars": [
    { "key": "NEXT_PUBLIC_SITE_URL", "description": "Public site URL", "example": "http://localhost:3000", "required": false }
  ],
  "conventions": {
    "appDir": "app",
    "componentsDir": "components",
    "libDir": "lib",
    "testsDir": "tests",
    "naming": "kebab-case files, PascalCase components"
  },
  "generator": "website-generator"
}
