# ForgeOS — Variables de entorno

# Proveedor IA visible en UI (stub | openai | anthropic)
NEXT_PUBLIC_AI_PROVIDER=stub

# ── AI Gateway (Release multi-provider) ──────────────────────────
AI_DEFAULT_PROVIDER=anthropic
AI_FALLBACK_PROVIDER=openai
AI_ENABLE_MOCK_FALLBACK=true

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-1.5-pro

# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Groq (fast inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local / Open Source (OpenAI-compatible endpoint)
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=local

# ── AI Runtime RC3 — Extended Providers ───────────────────────────
AI_MONTHLY_BUDGET_USD=100

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL=gpt-4o

# AWS Bedrock (stub)
AWS_BEDROCK_REGION=
AWS_BEDROCK_MODEL=anthropic.claude-3-sonnet
AWS_ACCESS_KEY_ID=

# Vertex AI
VERTEX_AI_API_KEY=
VERTEX_AI_BASE_URL=
VERTEX_AI_MODEL=gemini-1.5-pro

# Cohere
COHERE_API_KEY=
COHERE_MODEL=command-r-plus

# xAI
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-beta

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# LM Studio (local)
LMSTUDIO_BASE_URL=http://localhost:1234
LMSTUDIO_MODEL=local-model

# Llama (via Groq or custom endpoint)
LLAMA_API_KEY=
LLAMA_BASE_URL=
LLAMA_MODEL=llama-3.3-70b

# MCP — Model Context Protocol (pending)
# MCP_ENDPOINT=
# MCP_MODEL=mcp-pending

# ── Real Connections RC5 — External Tools (server-side only) ─────
GITHUB_TOKEN=
SUPABASE_ACCESS_TOKEN=
VERCEL_TOKEN=
CLOUDFLARE_API_TOKEN=
# Set to "true" to allow production execution (requires governance approval + user confirm)
# FORGEOS_CONNECTIONS_PRODUCTION=false

# ── Real Execution RC5.1 — Approval Layer (server-side only) ────
ENABLE_REAL_EXECUTION=false
REAL_EXECUTION_ALLOWED_PROVIDERS=github,vercel,supabase,cloudflare
REAL_EXECUTION_REQUIRE_APPROVAL=true
REAL_EXECUTION_DEFAULT_ENVIRONMENT=preview
REAL_EXECUTION_ALLOW_DESTRUCTIVE=false

# Per-provider real execution (RC5.3) — all false by default
ENABLE_REAL_GITHUB_EXECUTION=false
ENABLE_REAL_VERCEL_EXECUTION=false
ENABLE_REAL_SUPABASE_EXECUTION=false
ENABLE_REAL_CLOUDFLARE_EXECUTION=false

# ── Real AI Execution Platform RC6 (server-side only) ─────────────
ENABLE_REAL_AI=false
ENABLE_STREAMING=true
ENABLE_MULTI_PROVIDER_ROUTING=true
ENABLE_COST_OPTIMIZER=true

# ── Program 3000 Sprint 4 — Design Partner AI Gate ───────────────
# Real AI activates only when ENABLE_REAL_AI=true AND (design partner OR keys below)
ENABLE_DESIGN_PARTNER_AI=false
DESIGN_PARTNER_MODE=false
NEXT_PUBLIC_DESIGN_PARTNER_MODE=false

# ── Program 5000 — Design Partner Program ───────────────────────
ENABLE_DESIGN_PARTNER_ANALYTICS=true
NEXT_PUBLIC_ENABLE_DESIGN_PARTNER_ANALYTICS=true
# Optional analytics POST endpoint (reuses BETA_ANALYTICS_ENDPOINT if unset)
# DESIGN_PARTNER_ANALYTICS_ENDPOINT=

# RC6 provider keys (aliases supported)
GEMINI_API_KEY=
AZURE_OPENAI_KEY=
LM_STUDIO_BASE_URL=http://localhost:1234

# ── Real Build Flow RC5.2 — Venture → Preview (server-side only) ──
ENABLE_REAL_BUILD_FLOW=false
REAL_BUILD_REQUIRE_APPROVAL=true
REAL_BUILD_DEFAULT_ENVIRONMENT=preview

# ── Program 3000 Sprint 5 — Build Pipeline (server-side only) ─────
# Unified dashboard at /deployments — preview only, approval required
# ENABLE_REAL_BUILD_FLOW=false (reuses RC5.2 flags above)
# All real execution behind ENABLE_REAL_EXECUTION + per-provider flags

# ── Program 3000 Sprint 6 — Private Beta Platform ───────────────
BETA_MODE=true
NEXT_PUBLIC_BETA_MODE=true
ENABLE_BETA_ANALYTICS=true
NEXT_PUBLIC_ENABLE_BETA_ANALYTICS=true
ENABLE_CRASH_REPORTS=true
NEXT_PUBLIC_ENABLE_CRASH_REPORTS=true
# Optional analytics POST endpoint (stub — no external SDK required)
# BETA_ANALYTICS_ENDPOINT=

# ── Program 3000 — Identity Platform (Sprint 1) ─────────────────
NEXT_PUBLIC_AUTH_ENABLED=true
# local | supabase | authjs
NEXT_PUBLIC_AUTH_PROVIDER=local

# Supabase Auth (when NEXT_PUBLIC_AUTH_PROVIDER=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Auth.js / NextAuth (when NEXT_PUBLIC_AUTH_PROVIDER=authjs)
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Program 3000 Sprint 3 — Venture Persistence ───────────────────
# local | supabase | postgres
PERSISTENCE_PROVIDER=local
NEXT_PUBLIC_PERSISTENCE_PROVIDER=local

# Supabase persistence (when PERSISTENCE_PROVIDER=supabase)
# Reuses NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY above
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Postgres persistence (when PERSISTENCE_PROVIDER=postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/forgeos

# ── Program 6000 — Commercial Readiness ───────────────────────────
COMMERCIAL_MODE=true
NEXT_PUBLIC_COMMERCIAL_MODE=true
ENABLE_STRIPE_BILLING=false
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# ENABLE_COMMERCIAL_EMAILS=false

# ── Program 9000 — Intelligence Network ───────────────────────────
ENABLE_INTELLIGENCE_NETWORK=false
NETWORK_CONSENT_REQUIRED=true
ENABLE_ANONYMIZED_BENCHMARKS=true

# ── Program 8000 — Customer Success Platform ────────────────────
ENABLE_CUSTOMER_SUCCESS_ANALYTICS=true
NEXT_PUBLIC_CS_PLATFORM=true
# Optional analytics POST endpoint (reuses DESIGN_PARTNER_ANALYTICS_ENDPOINT)
# CUSTOMER_SUCCESS_ANALYTICS_ENDPOINT=

# ── Program 7000 — ForgeOS 1.0 Launch ────────────────────────────
FORGEOS_LAUNCH_MODE=true
NEXT_PUBLIC_LAUNCH_MODE=true

# ── Program 6500 — Production Readiness ───────────────────────────
ENABLE_PRODUCTION_MONITORING=true
NEXT_PUBLIC_ENABLE_PRODUCTION_MONITORING=true
ENABLE_KILL_SWITCH=false
PRODUCTION_HEALTH_ENDPOINT=
PRODUCTION_DRY_RUN=true
ENABLE_STRUCTURED_LOGGING=false
ENABLE_PRODUCTION_TRACING=false
ENABLE_PRODUCTION_METRICS=false
NEXT_PUBLIC_ENABLE_PRODUCTION_METRICS=false
PRODUCTION_RATE_LIMIT_PER_MINUTE=120
# KILL_SWITCH_REASON=
# KILL_SWITCH_ACTIVATED_AT=

# ── Program 4300 — Cloud Foundation (preparation only) ────────────
CLOUD_DRY_RUN=true
CLOUD_PREVIEW_ONLY=true
CLOUD_PRODUCTION_BLOCKED=true
CLOUD_ACTIVE_ENVIRONMENT=preview
CLOUD_PROVIDERS=github,vercel,cloudflare,supabase

# GitHub strategy
GITHUB_ORG=forgeos
GITHUB_REPO=forgeos-app-factory

# Vercel (per environment — placeholders only)
VERCEL_PROJECT_NAME=forgeos-app-factory
# VERCEL_TOKEN= (see Real Connections section above)

# Cloudflare (per environment — placeholders only)
CLOUDFLARE_ZONE_NAME=forgeos.app
# CLOUDFLARE_API_TOKEN= (see Real Connections section above)

# Supabase per environment (placeholders — no real secrets)
# SUPABASE_DEV_URL=
# SUPABASE_DEV_ANON_KEY=
# SUPABASE_PREVIEW_URL=
# SUPABASE_PREVIEW_ANON_KEY=
# SUPABASE_STAGING_URL=
# SUPABASE_STAGING_ANON_KEY=
# SUPABASE_PROD_URL=
# SUPABASE_PROD_ANON_KEY=
# SUPABASE_STAGING_SERVICE_ROLE_KEY=
# SUPABASE_PROD_SERVICE_ROLE_KEY=

# ── Program 5380 — One-Click Preview Deployment (server-side only) ─
ENABLE_PREVIEW_DEPLOYMENT=false
ENABLE_PREVIEW_GITHUB_PUSH=false
ENABLE_PREVIEW_VERCEL_DEPLOYMENT=false
ENABLE_PREVIEW_SUPABASE_SETUP=false
PREVIEW_DEPLOYMENT_REQUIRE_APPROVAL=true
PREVIEW_DEPLOYMENT_ENVIRONMENT=preview
PREVIEW_DEPLOYMENT_ALLOW_PRODUCTION=false

# ── Program 6070 — Legacy Migration and Compatibility (all OFF / gradual) ─
# Keep legacy authoritative when all V2 flags are false.
ENABLE_V2_DOMAIN=false
ENABLE_V2_COMMANDS=false
ENABLE_V2_QUERIES=false
ENABLE_V2_ORCHESTRATION=false
ENABLE_V2_EVENTS=false
ENABLE_V2_STUDIO=false
ENABLE_V2_COMPANY_OS=false
