{
  "id": "webapp-nextjs-supabase",
  "name": "Web Application — Next.js + Supabase",
  "version": "1.0.0",
  "projectType": "web_application",
  "stack": {
    "framework": "nextjs",
    "language": "typescript",
    "styling": "tailwindcss",
    "database": "supabase",
    "auth": "supabase-auth"
  },
  "structure": [
    "app/(auth)/",
    "app/(app)/",
    "app/(admin)/",
    "components/",
    "lib/supabase/",
    "lib/services/",
    "lib/repositories/",
    "supabase/migrations/",
    "middleware.ts"
  ],
  "dependencies": {
    "next": "15.x",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@supabase/supabase-js": "^2.49.0",
    "@supabase/ssr": "^0.5.0",
    "clsx": "^2.1.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tailwindcss": "^3.4.0",
    "vitest": "^2.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "db:types": "echo 'Run supabase gen types locally'"
  },
  "envVars": [
    { "key": "NEXT_PUBLIC_SUPABASE_URL", "description": "Supabase project URL", "example": "https://your-project.supabase.co", "required": true },
    { "key": "NEXT_PUBLIC_SUPABASE_ANON_KEY", "description": "Supabase anon key", "example": "your-anon-key", "required": true },
    { "key": "SUPABASE_SERVICE_ROLE_KEY", "description": "Service role (server only)", "example": "your-service-role-key", "required": false, "secret": true }
  ],
  "conventions": {
    "appDir": "app",
    "componentsDir": "components",
    "libDir": "lib",
    "testsDir": "tests",
    "naming": "kebab-case routes, PascalCase components"
  },
  "generator": "web-application-generator"
}
