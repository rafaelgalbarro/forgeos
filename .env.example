# RESEND_API_KEY=
# EMAIL_FROM=noreply@forgeos.trade
# NEXT_PUBLIC_APP_URL=https://forgeos.trade
# AUTH_RESET_SECRET=  # optional; falls back to RESEND_API_KEY for HMAC

# ── FOREX module (/investment/forex) — IBKR IDEALPRO CASH ─────────
# Keep FOREX_ENABLED=false until broker forex endpoints + live gates are certified.
FOREX_ENABLED=false
FOREX_MAX_SPREAD_PIPS=3
FOREX_MAX_POSITIONS=3
FOREX_RISK_PCT=2
FOREX_STOP_PIPS=20
FOREX_TP_PIPS=40
FOREX_MIN_CONFIDENCE=0.75
