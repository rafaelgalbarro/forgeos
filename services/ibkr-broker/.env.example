APP_ENV=development
INTERNAL_API_KEY=replace-with-a-long-random-secret
APPROVAL_SECRET=replace-with-a-different-long-random-secret

IBKR_HOST=127.0.0.1
IBKR_PORT=4001
IBKR_CLIENT_ID=41
IBKR_ACCOUNT_ID=
IBKR_CONNECT_TIMEOUT_SECONDS=12
IBKR_READ_ONLY=true

LIVE_TRADING_ENABLED=false
PROPOSAL_TTL_SECONDS=600
MAX_ORDER_NOTIONAL=250
MAX_ORDER_QUANTITY=2
ALLOWED_SYMBOLS=AAPL,MSFT
ALLOWED_CURRENCIES=EUR,USD
ALLOWED_EXCHANGES=SMART
DATABASE_PATH=./forgeos_ibkr.sqlite3
